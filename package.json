{
  "name": "mwanga",
  "version": "0.14.2",
  "description": "Church projection software by ChurchyCodes: songs, Bible verses and notices on the big screen.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env MWANGA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:linux": "vite build && electron-builder --linux AppImage --publish never",
    "release:win": "vite build && electron-builder --win --publish always"
  },
  "author": "ChurchyCodes",
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "productName": "Mwanga",
  "private": true,
  "type": "module",
  "build": {
    "appId": "tz.churchycodes.mwanga",
    "productName": "Mwanga",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "data/**",
      "package.json",
      "build/icon.png",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/@huggingface/transformers/dist/*.wasm",
      "!**/node_modules/@huggingface/transformers/dist/transformers.js",
      "!**/node_modules/@huggingface/transformers/dist/transformers.min.js",
      "!**/node_modules/@huggingface/transformers/dist/*.map",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v*/*/arm64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/linux/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Mwanga"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v*/win32/**"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lumanya",
        "repo": "churchy-projection",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lumanya/churchy-projection.git"
  }
}
