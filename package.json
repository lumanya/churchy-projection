{
  "name": "mwanga",
  "version": "0.1.0",
  "description": "Church projection software by ChurchyCodes: songs, Bible verses and notices on the big screen.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env MWANGA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:linux": "vite build && electron-builder --linux AppImage --publish never"
  },
  "author": "ChurchyCodes",
  "license": "UNLICENSED",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wait-on": "^9.5.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {},
  "productName": "Mwanga",
  "private": true,
  "type": "module",
  "build": {
    "appId": "tz.churchycodes.mwanga",
    "productName": "Mwanga",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "data/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Mwanga"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lumanya/churchy-projection.git"
  }
}
